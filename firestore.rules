rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque personne ne peut lire et écrire que ses propres carnets.
    match /users/{uid}/kv/{key} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && key.matches('^[a-z0-9-]{1,64}$')
        && request.resource.data.keys().hasOnly(['v', 'at'])
        && request.resource.data.v is string
        && request.resource.data.v.size() < 1000000
        && request.resource.data.at is number;
    }
  }
}
